# Path al ejecutable de Chromium/Chrome en tu sistema
# Linux: /usr/bin/chromium o /usr/bin/chromium-browser
# Mac:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# --- API del agente ---
# URL base de la API de ChatSunTalk (FastAPI).
# Si la FastAPI corre en tu máquina host (fuera de esta red docker), usa
# host.docker.internal (el docker-compose ya mapea ese nombre al host con host-gateway).
# NO uses localhost: dentro del contenedor apunta al propio contenedor, no al host.
CHATSUNTALK_API_URL=http://host.docker.internal:8000
# Ruta del endpoint. Versión actual: /v4/chatsuntalk/whatsapp
# (históricas: v3 /v3/chatsuntalk/whatsapp — v2 /chatsuntalk/whatsapp)
CHATSUNTALK_API_PATH=/v4/chatsuntalk/whatsapp
# Debe coincidir con API_KEY del agente (el router v4 exige el header X-API-Key en todas
# sus rutas). Déjalo vacío sólo si el endpoint no tiene autenticación.
CHATSUNTALK_API_KEY=
# Timeout (ms) de la llamada al agente: un turno incluye LLM + transcripción/visión.
CHATSUNTALK_API_TIMEOUT_MS=120000

# Modelo de LLM a usar (se pasa al endpoint en el campo `model`). Debe estar
# registrado y sembrado en el agente (ChatSunTalk/src/services/model_registry.py).
# Valores válidos (cualquier otro lo rechaza el agente con 422):
#   Groq:     openai/gpt-oss-120b | llama-3.3-70b-versatile
#   Google:   gemini-2.5-flash | gemini-3.5-flash | gemini-3.5-flash-lite
#   DeepSeek: deepseek-v4-flash | deepseek-v4-pro
LLM_MODEL=openai/gpt-oss-120b

# --- Almacenamiento de media (S3-compatible) ---
# En desarrollo: el MinIO del docker-compose.
# En producción: Backblaze B2 — misma API S3, solo cambian estas variables:
#   S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   S3_PUBLIC_ENDPOINT=https://s3.us-west-004.backblazeb2.com
#   S3_REGION=us-west-004
#   S3_ACCESS_KEY=<keyID>   S3_SECRET_KEY=<applicationKey>
#   S3_ENSURE_BUCKET=false  (B2 no soporta CreateBucket por la API S3)

# Endpoint por el que SUBE el bridge.
S3_ENDPOINT=http://minio:9000
# Endpoint con el que se FIRMA la URL de descarga: tiene que ser resoluble DESDE EL
# AGENTE (la firma SigV4 incluye el host, por eso puede diferir del de subida).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whatsapp-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO requiere path-style. B2 también lo acepta.
S3_FORCE_PATH_STYLE=true
# Crear el bucket al arrancar si no existe (true con MinIO, false con B2).
S3_ENSURE_BUCKET=true
# Vida (s) del enlace prefirmado que recibe el agente.
MEDIA_URL_TTL=3600
# Tope de tamaño del archivo descargado de WhatsApp (bytes). Default: 20 MB.
MEDIA_MAX_BYTES=20971520

# Puertos publicados por MinIO en el host (API y consola web).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
